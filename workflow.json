{
  "name": "Barangay Distribution Coordinator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "beneficiary-distribution",
        "options": {}
      },
      "id": "d1e2f3a4-b5c6-7d8e-9f0a-b1c2d3e4f5a6",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "distribution-webhook"
    },
    {
      "parameters": {
        "fieldToSplitOut": "sitio_batches",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-e1f2a3b4c5d6",
      "name": "Loop Sitios",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "emails",
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Loop Emails",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "admin@peoplemapbaranggay.com",
        "toEmail": "={{$json.item}}",
        "subject": "=Notice: {{$node[\"Webhook\"].json.body.title}} for Sitio {{$node[\"Loop Sitios\"].json.sitio_name}}",
        "html": "=<div style=\"font-family: sans-serif; max-width: 600px; margin: auto; border: 2px solid #3b82f6; border-radius: 20px; overflow: hidden;\">\n  <div style=\"background-color: #3b82f6; padding: 30px; color: white; text-align: center;\">\n    <h2 style=\"margin: 0; text-transform: uppercase;\">Distribution Notice</h2>\n    <p style=\"margin: 5px 0 0 0;\">Sitio {{$node[\"Loop Sitios\"].json.sitio_name}}</p>\n  </div>\n  <div style=\"padding: 30px;\">\n    <p>Good day! This is a notice for all <strong>{{$node[\"Webhook\"].json.body.target_group_label}}</strong> residents of <strong>Sitio {{$node[\"Loop Sitios\"].json.sitio_name}}</strong>.</p>\n    <p>Please be informed of the following distribution event:</p>\n    <div style=\"background: #f8fafc; padding: 20px; border-radius: 10px; margin: 20px 0;\">\n      <strong>Event:</strong> {{$node[\"Webhook\"].json.body.title}}<br>\n      <strong>Date:</strong> {{$node[\"Webhook\"].json.body.distribution_date}}<br>\n      <strong>Location:</strong> {{$node[\"Webhook\"].json.body.location}}\n    </div>\n    <p style=\"color: #ef4444; font-weight: bold;\">Important: Please bring your valid ID and Beneficiary Card.</p>\n  </div>\n</div>"
      },
      "id": "c3d4e5f6-a7b8-c9d0-e1f2-a3b4c5d6e7f8",
      "name": "Send Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Loop Sitios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Sitios": {
      "main": [
        [
          {
            "node": "Loop Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Emails": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Notification": {
      "main": [
        [
          {
            "node": "Loop Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }

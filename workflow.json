{
  "name": "Barangay Omnichannel Broadcast",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "announcement-broadcast",
        "options": {}
      },
      "id": "7a8b9c0d-e1f2-3a4b-5c6d-7e8f9a0b1c2d",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "barangay-broadcast-webhook"
    },
    {
      "parameters": {
        "fieldToSplitOut": "recipients",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-e1f2a3b4c5d6",
      "name": "Split Recipients",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "news@peoplemapbaranggay.com",
        "toEmail": "={{$json.item}}",
        "subject": "={{$node[\"Webhook\"].json.body.title}}",
        "html": "=<div style=\"font-family: 'Helvetica', sans-serif; max-width: 600px; margin: auto; border: 1px solid #e2e8f0; border-radius: 20px; overflow: hidden;\">\n  <div style=\"background-color: #2563eb; padding: 40px; text-align: center; color: white;\">\n    <h1 style=\"margin: 0; font-style: italic; text-transform: uppercase; letter-spacing: -1px;\">{{$node[\"Webhook\"].json.body.category}} Announcement</h1>\n  </div>\n  <div style=\"padding: 40px; background-color: white;\">\n    <h2 style=\"color: #1e293b; font-size: 24px; margin-top: 0;\">{{$node[\"Webhook\"].json.body.title}}</h2>\n    <p style=\"color: #64748b; line-height: 1.6; font-size: 16px;\">{{$node[\"Webhook\"].json.body.content}}</p>\n    <div style=\"margin-top: 40px; padding-top: 20px; border-top: 1px solid #f1f5f9; color: #94a3b8; font-size: 12px; font-weight: bold; text-transform: uppercase;\">\n      Published on {{$node[\"Webhook\"].json.body.published_at}}\n    </div>\n  </div>\n  <div style=\"background-color: #f8fafc; padding: 20px; text-align: center; color: #94a3b8; font-size: 10px;\">\n    This is an official community broadcast from PeopleMapBaranggay.\n  </div>\n</div>"
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Split Recipients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Recipients": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Split Recipients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}